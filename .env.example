# ---------------------------------------------------------------------------
# Tutorly environment. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Postgres. Local dev, Neon or Supabase all work — it is plain Postgres.
DATABASE_URL="postgres://tutorly:tutorly@127.0.0.1:5432/tutorly"

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Auth.js sits behind a proxy on Vercel; keep this true in production.
AUTH_TRUST_HOST="true"

# Google OAuth (optional in dev — the sign-in button hides itself when unset).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App-level encryption for payout bank details (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotating this key makes existing encrypted payout rows unreadable.
PAYOUT_ENCRYPTION_KEY="replace-me-with-openssl-rand-base64-32"

# Payments. "mock" instantly credits the wallet in dev; the real provider drops
# in behind the same PaymentProvider interface (see SPEC.md §14).
PAYMENT_PROVIDER="mock"

# ---------------------------------------------------------------------------
# Not used until later phases — listed here so the shape is known.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=""
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""
# Cloudflare R2 (SPEC.md §13.5). With none of these set the app writes to
# `.storage/` on disk and the rest of the codebase cannot tell the difference.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BUCKET=""
# R2_PRIVATE_BUCKET=""
# R2_PUBLIC_BASE_URL=""

# Local object store when R2 is not configured (development default).
LOCAL_STORAGE_DIR=".storage"

# ---------------------------------------------------------------------------
# Email (SPEC.md §11). Without both of these the app queues mail and sends
# nothing — correct for a preview deployment, a disaster in production, so
# /api/health reports which one you are on.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Must be a domain verified with Resend, with SPF, DKIM and DMARC in DNS.
# See LAUNCH.md.
EMAIL_FROM="Tutorly <hello@example.com>"
EMAIL_REPLY_TO=""

# Vercel Cron shared secret. The cron routes 404 without it.
CRON_SECRET=""

# Local transcoding for intro videos. Falls back to `ffmpeg` / `ffprobe` on PATH.
# FFMPEG_PATH=""
# FFPROBE_PATH=""

# LiveKit (SPEC.md §7). Without these the classroom refuses to start rather
# than dropping a student into a room that will never connect.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
