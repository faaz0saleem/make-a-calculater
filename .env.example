# ---------------------------------------------------------------------------
# Tutorly environment. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Postgres. Local dev, Neon or Supabase all work — it is plain Postgres.
DATABASE_URL="postgres://tutorly:tutorly@127.0.0.1:5432/tutorly"

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Auth.js sits behind a proxy on Vercel; keep this true in production.
AUTH_TRUST_HOST="true"

# Google OAuth (optional in dev — the sign-in button hides itself when unset).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App-level encryption for payout bank details (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Rotating this key makes existing encrypted payout rows unreadable.
PAYOUT_ENCRYPTION_KEY="replace-me-with-openssl-rand-base64-32"

# Payments. "mock" instantly credits the wallet in dev; the real provider drops
# in behind the same PaymentProvider interface (see SPEC.md §14).
PAYMENT_PROVIDER="mock"

# ---------------------------------------------------------------------------
# Not used until later phases — listed here so the shape is known.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=""
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_BUCKET=""
# R2_PRIVATE_BUCKET=""
# RESEND_API_KEY=""
