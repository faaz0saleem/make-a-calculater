{
  "name": "tutorly",
  "version": "0.1.0",
  "private": true,
  "description": "Tutorly \u2014 a discovery-first tutoring marketplace.",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --tsconfig tsconfig.scripts.json src/db/seed.ts",
    "reconcile": "tsx --tsconfig tsconfig.scripts.json src/scripts/reconcile.ts",
    "db:reset": "tsx --tsconfig tsconfig.scripts.json src/db/migrate.ts && tsx --tsconfig tsconfig.scripts.json src/db/seed.ts",
    "e2e": "tsx src/db/seed.ts && playwright test",
    "e2e:ui": "playwright test --ui",
    "rank": "tsx --tsconfig tsconfig.scripts.json src/scripts/rank-tutors.ts",
    "settle": "tsx --tsconfig tsconfig.scripts.json src/scripts/settle.ts",
    "series": "tsx --tsconfig tsconfig.scripts.json src/scripts/series.ts",
    "reminders": "tsx --tsconfig tsconfig.scripts.json src/scripts/reminders.ts",
    "email": "tsx --tsconfig tsconfig.scripts.json src/scripts/email.ts",
    "prove:booking": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-no-double-booking.ts",
    "prove:commission": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-commission.ts",
    "prove:curriculum": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-curriculum.ts",
    "prove:rates": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-rates-frozen.ts",
    "prove:payout": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-payout-lock.ts",
    "prove:payout-privacy": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-payout-privacy.ts",
    "prove:restore": "tsx --tsconfig tsconfig.scripts.json src/scripts/prove-restore.ts",
    "launch:sql": "tsx --tsconfig tsconfig.scripts.json src/scripts/launch-sql.ts",
    "measure:regions": "tsx --tsconfig tsconfig.scripts.json src/scripts/measure-regions.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
